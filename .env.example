APP_JWT_SECRET=

DB_NAME=creatoros
DB_USER=creatoros
DB_PASSWORD=creatoros
DB_ROOT_PASSWORD=root

API_PORT=8082
DB_PORT=3307

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_JWT_EXPIRATION_MS=604800000

DB_POOL_MAX=10
DB_POOL_MIN=2

# Brevo transactional email API key (Settings -> SMTP & API -> API Keys). Team invitation
# emails silently fail to send without it - the invite itself still succeeds.
BREVO_API_KEY=

# Razorpay (Settings -> API Keys for key id/secret; Settings -> Webhooks for the webhook secret,
# configured against POST /api/v1/webhooks/razorpay with the payment_link.paid event enabled).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# One-time price to activate the paid plan; the plan stays active until cancelled, no auto-renewal.
RAZORPAY_SUBSCRIPTION_AMOUNT_INR=999
